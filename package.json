{
  "name": "crystalline-tweak-studio",
  "productName": "Crystalline",
  "version": "1.1.0",
  "description": "Crystalline — Windows 10/11 system tuning with snapshot safety (native Rust engine + Electron)",
  "main": "electron/main.js",
  "scripts": {
    "build:catalog": "node tweaks/build_catalog.js",
    "build:engine": "cargo build --release --manifest-path native-engine/Cargo.toml && copy /y native-engine\\target\\release\\crystalline-engine.exe native-engine\\crystalline-engine.exe",
    "build": "npm run build:catalog && npm run build:engine",
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "test:engine": "native-engine\\crystalline-engine.exe --self-test",
    "pack": "node pack_release.js"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "33.4.0"
  }
}
